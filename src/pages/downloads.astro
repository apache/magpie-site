---
import ContentLayout from "../layouts/ContentLayout.astro";


// ── Release configuration ────────────────────────────────────────────────
// This page is the ASF-compliant download page (issue #46), wired to the
// Apache distribution system. Everything below — the mirror download link, the
// checksum / signature / KEYS links, and the verification steps — is derived
// from the version.
//
// TO CUT A NEW RELEASE: bump `version` and set `date` (ISO) once the release
// has been voted by the PMC and pushed to the Apache distribution SVN
// (https://dist.apache.org/repos/dist/release/magpie/).
const PROJECT = "magpie";
const release = {
  version: "0.1.0",
  date: "2026-07-19" as string | null,
};

const artifact = `apache-${PROJECT}-${release.version}-source.zip`;

// Per ASF policy, the release artifact is fetched through the mirror system
// (closer.lua redirects to a nearby mirror), while the detached signature, the
// checksum and the KEYS file are served ONLY from the canonical
// downloads.apache.org and are never mirrored — they are what you verify the
// mirrored download against. Release artifacts live in a per-version
// subdirectory; KEYS lives at the project root.
const DIST = `https://downloads.apache.org/${PROJECT}`;
const DIST_VERSION = `${DIST}/${release.version}`;
const dl = {
  mirror: `https://www.apache.org/dyn/closer.lua/${PROJECT}/${release.version}/${artifact}`,
  sha512: `${DIST_VERSION}/${artifact}.sha512`,
  asc: `${DIST_VERSION}/${artifact}.asc`,
  keys: `${DIST}/KEYS`,
  archive: `https://archive.apache.org/dist/${PROJECT}/`,
};
const VERIFY = "https://www.apache.org/info/verification.html";

const verifySteps = `# Import the project's release-signing keys (once)
curl -fsSLO ${DIST}/KEYS
gpg --import KEYS

# Verify the detached PGP signature
gpg --verify ${artifact}.asc ${artifact}

# Optional: Verify the SHA-512 checksum: not needed if the signature checks out
sha512sum -c ${artifact}.sha512`;

const prettyDate = release.date
  ? new Date(release.date).toLocaleDateString("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---
<ContentLayout title="Downloads" description="Signed source releases of Apache Magpie, distributed through the Apache mirror network.">
  <section><h2>Install Magpie</h2><p>The marketplace is the usual starting point. Use the signed source archive when you need an offline installation or a verified ASF release.</p><div class="link-row"><a href="/start">Install in your agent </a><a href="/docs/quick-start/other-install-methods">Other installation methods </a></div></section>

  <section class="surface-card release-card"><h2>Apache Magpie {release.version}<small>{prettyDate}</small></h2><a class="button" href={dl.mirror} target="_blank" rel="noreferrer">Download source ZIP</a><div class="link-row"><a href={dl.asc} target="_blank" rel="noreferrer">PGP signature</a><a href={dl.sha512} target="_blank" rel="noreferrer">SHA-512 checksum</a><a href={dl.keys} target="_blank" rel="noreferrer">Signing keys</a></div></section>
  <section id="verify"><h2>Verify your download</h2><p>Download the signature and signing keys above, then verify the source archive before using it.</p><pre tabindex="0" aria-label="Download verification commands"><code>{verifySteps}</code></pre><div class="link-row"><a href={VERIFY} target="_blank" rel="noreferrer">Apache verification guide </a></div></section>

  <section><h2>Previous releases</h2><p>Older source releases remain available in the Apache archive.</p><div class="link-row"><a href={dl.archive} target="_blank" rel="noreferrer">Browse the archive </a></div></section>
</ContentLayout>
