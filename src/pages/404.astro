---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SiteHeader } from '../components/landing/SiteHeader';
import { SiteFooter } from '../components/landing/SiteFooter';
---
<BaseLayout title="Page not found | Apache Magpie">
  <SiteHeader />
  <main id="main-content" tabindex="-1" class="container not-found"><div><h1>We couldn’t find that page</h1><p>The page may have moved. Let’s get you back to a useful place.</p><a class="button" href="/docs">Browse the documentation </a><a class="text-link" href="/">Back to Magpie </a></div><img src="/illustrations/magpie/magpie-flying.png" alt="A magpie taking flight" width="300" height="300" /></main>
  <SiteFooter />
</BaseLayout>
