---
import ContentLayout from '../layouts/ContentLayout.astro';
import { CardHeading } from '../components/landing/WorkflowCard';
import { Rocket, GraduationCap, Compass, Users, PenLine, BookOpen, Blocks, Layers } from 'lucide-react';
import { siteEditUrl } from '../lib/site';
const resources = [
  { title: 'Get started', text: 'Install Magpie in your own workspace.', href: '/start', icon: Rocket },
  { title: 'Working with agents', text: 'A practical introduction for maintainers.', href: '/docs/education/readme', icon: GraduationCap },
  { title: 'Choose a workflow', text: 'Find the skills that fit your project.', href: '/docs/quick-start/families', icon: Compass },
  { title: 'Adopt as a team', text: 'Agree the conventions your project shares.', href: '/docs/setup/team-adoption', icon: Users },
  { title: 'Write a skill', text: 'Build and test your own maintainer workflow.', href: '/docs/education/your-first-skill', icon: PenLine },
  { title: 'Training materials', text: 'Lessons and a hands-on lab for your team.', href: '/docs/education/training/readme', icon: BookOpen },
  { title: 'Extend Magpie', text: 'Add a tool, workflow, or organization.', href: '/docs/extending', icon: Blocks },
  { title: 'Agentic modes', text: 'How mature each way of working is.', href: '/docs/modes', icon: Layers },
];
---
<ContentLayout editUrl={siteEditUrl('src/pages/resources.astro')} title="Learn and extend" description="Practical guides for using Magpie and making it your own.">
  <div class="arch-flow">{resources.map(item => <a href={item.href} class="surface-card workflow-card card-link arch-card"><CardHeading title={item.title} linkArrow><item.icon slot="icon" aria-hidden="true" /></CardHeading><p>{item.text}</p></a>)}</div>
</ContentLayout>
