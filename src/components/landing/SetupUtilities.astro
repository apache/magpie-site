---
import { ArrowRight, ShieldCheck, Bot, FolderCode, LockKeyhole, KeyRound, UserRound, FolderX, Globe, TriangleAlert, TreePalm } from "lucide-react";
import MagpieCard from "./MagpieCard";
import WorkflowCard from "./WorkflowCard";
import SectionHeading from "./SectionHeading";
---
<section id="agent-isolation" class="setup-utilities container isolation-comparison" aria-labelledby="setup-utilities-title">
  <div class="setup-explanation">
    <SectionHeading id="setup-utilities-title" target="agent-isolation">Give your agent a workspace, not your whole machine</SectionHeading>
    <p>Magpie installs and verifies layered protection so you can work on untrusted software locally, without a separate VM on macOS or Linux.</p>
  </div>
  <div class="isolation-sides">
    <WorkflowCard className="isolation-side isolation-open" tone="risk" title="In YOLO mode" emphasis="What if my agent deletes all my files?">
      <TriangleAlert slot="icon" size={48} aria-hidden="true" />
      <div class="agent-diagram">
        <div class="diagram-agent"><Bot size={40} aria-hidden="true" /><span>Your agent</span></div>
        <div class="open-access" aria-hidden="true"></div>
        <ul class="exposed-resources" aria-label="Risks when protections are disabled">
          <li><FolderX aria-hidden="true" /><span><strong>Personal files</strong>Can be changed or deleted</span></li>
          <li><KeyRound aria-hidden="true" /><span><strong>Credentials</strong>Can be read or exposed</span></li>
          <li><Globe aria-hidden="true" /><span><strong>Network</strong>Data can leave your machine</span></li>
        </ul>
        <div class="yolo-wildcard"><TreePalm aria-hidden="true" /><span>A loan for Hawaii next?</span><span class="yolo-question" aria-hidden="true">??</span></div>
      </div>
    </WorkflowCard>
    <MagpieCard className="isolation-side isolation-protected" tone="result" emphasis="I decide what my agent can access.">
      <div class="agent-diagram">
        <div class="diagram-agent"><Bot size={40} aria-hidden="true" /><span>Your agent</span></div>
        <div class="protected-access" aria-hidden="true"></div>
        <svg class="protection-route" aria-hidden="true"><polyline /><path /></svg>
        <div class="protection-layer">
          <span class="layer-label"><KeyRound aria-hidden="true" /><span>Environment credentials removed</span></span>
          <div class="protection-layer">
            <span class="layer-label"><ShieldCheck aria-hidden="true" /><span>File and network access sandboxed</span></span>
            <div class="protection-layer">
              <span class="layer-label"><LockKeyhole aria-hidden="true" /><span>Agent tools restricted</span></span>
              <div class="protection-layer">
                <span class="layer-label"><UserRound aria-hidden="true" /><span>Approval required for external writes</span></span>
                <div class="protected-workspace"><FolderCode size={32} aria-hidden="true" /><span><strong>Your allowed workspace</strong>Project files</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </MagpieCard>
  </div>
  <div class="section-followup"><a class="button button-soft" href="/docs/setup/secure-agent-setup" target="_blank" rel="noreferrer"><span>Set up agent isolation</span><ArrowRight className="cta-arrow" aria-hidden="true" /></a></div>
</section>

<script>
  const diagram = document.querySelector<HTMLElement>('.isolation-protected .agent-diagram');
  if (diagram) {
    const route = diagram.querySelector<SVGSVGElement>('.protection-route')!;
    const updateRoute = () => {
      const origin = diagram.getBoundingClientRect();
      const agent = diagram.querySelector('.diagram-agent')!.getBoundingClientRect();
      const workspace = diagram.querySelector('.protected-workspace')!.getBoundingClientRect();
      const labels = [...diagram.querySelectorAll('.layer-label')].map(el => el.getBoundingClientRect());
      const x = (value: number) => value - origin.left;
      const y = (value: number) => value - origin.top;
      const startX = x((agent.left + agent.right) / 2);
      const turnY = y(agent.bottom + 26);
      const points = [[startX, y(agent.bottom + 12)], [startX, turnY], [x(labels[0].right - 8), turnY]];
      for (const [index, label] of labels.entries()) {
        points.push([x(label.right - 8), y(label.bottom + 4)]);
        if (labels[index + 1]) points.push([x(labels[index + 1].right - 8), y(label.bottom + 4)]);
      }
      const endX = x((workspace.left + workspace.right) / 2), endY = y(workspace.top + 12);
      points.push([endX, y(workspace.top - 4)], [endX, endY]);
      route.querySelector('polyline')!.setAttribute('points', points.map(point => point.join(',')).join(' '));
      route.querySelector('path')!.setAttribute('d', `M ${endX - 4} ${endY - 4} l 4 4 l 4 -4`);
    };
    new ResizeObserver(updateRoute).observe(diagram);
    updateRoute();
  }
</script>
