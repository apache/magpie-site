---
import { ArrowRight, BrainCircuit, Coffee } from "lucide-react";
import { MagpieToolkit } from "../landing/MagpieCard";
import CenteredLabel from "../landing/CenteredLabel";
import report from "../../data/airflow.json";

// A qualitative story, informed by the source's growth in incoming reports.
// Keep the time scale real, but do not confuse elapsed response time with effort.
const months = report.series.monthly.buckets.filter(month => month >= "2025-10" && month < report.generated.slice(0, 7));
const time = (month: string) => Date.parse(`${month}-01T00:00:00Z`);
const start = time(months[0]), end = time(months.at(-1)!);
const x = (month: string) => 45 + (time(month) - start) / (end - start) * 810;
const boom = x("2026-01"), adoption = x(report.adoption.slice(0, 7));
// The illustrative growth continues at the same rate across adoption. The
// pre-boom curves meet these lines with matching tangents, without a plateau.
const incomingRate = (245 - 32) / (855 - boom);
const effortRate = (300 - 135) / (855 - boom);
const adoptionEffort = 300 - effortRate * (adoption - boom);
const incomingPath = `M45 285 C125 280 ${boom - 80} ${245 + 80 * incomingRate} ${boom} 245 L855 32`;
const manualPath = `M45 330 C125 325 ${boom - 80} ${300 + 80 * effortRate} ${boom} 300 L${adoption} ${adoptionEffort}`;
const withoutPath = `M${adoption} ${adoptionEffort} L855 135`;
const withPath = `M${adoption} ${adoptionEffort} C${adoption + 90} ${adoptionEffort + 60} 745 340 855 350`;
const savedArea = `${withoutPath} L855 350 C745 340 ${adoption + 90} ${adoptionEffort + 60} ${adoption} ${adoptionEffort} Z`;
// One definition owns each visible curve and its label. textPath references
// that exact geometry, so labels follow edits to the graph automatically.
const curves = [
  { id: "airflow-incoming", line: "incoming-line", tone: "incoming-label", path: incomingPath, label: "Incoming external security reports", end: false, below: false },
  { id: "airflow-history", line: "manual-history", tone: "without-label", path: manualPath, label: "Maintainer time", end: false, below: false },
  { id: "airflow-without", line: "without-line", tone: "without-label", path: withoutPath, label: "Without Magpie", end: true, below: false },
  { id: "airflow-with", line: "time-line", tone: "time-label", path: withPath, label: "With Magpie", end: true, below: true },
];
const ticks = [
  { month: months[0], label: "Oct 2025" },
  { month: "2026-01", label: "Jan 2026" },
  { month: report.adoption.slice(0, 7), label: "Apr 2026" },
  { month: months.at(-1)!, label: "Aug 2026" },
];
---
<figure class="airflow-chart-story">
  <div class="chart-frame">
    <div class="chart-phases" style={`grid-template-columns:${boom}fr ${adoption - boom}fr ${900 - adoption}fr`}>
      <div><span class="card-badge" aria-hidden="true"><Coffee /></span><CenteredLabel>Good old days</CenteredLabel></div>
      <div class="chart-boom"><span class="card-badge" aria-hidden="true"><BrainCircuit /></span><CenteredLabel>The AI boom</CenteredLabel></div>
      <div class="chart-adoption"><span class="card-badge" aria-hidden="true"><MagpieToolkit /></span><CenteredLabel>Magpie introduced</CenteredLabel></div>
    </div>
    <svg viewBox="0 0 900 390" role="img" aria-labelledby="airflow-flow-title airflow-flow-desc">
      <title id="airflow-flow-title">Security reports and maintainer time, October 2025 to August 2026</title>
      <desc id="airflow-flow-desc">Illustrative trends over time, not monthly measurements. Security reports and manual effort rise rapidly during the AI boom. After Magpie adoption in April 2026, security reports continue rising while maintainer time falls. The amber branch shows a hypothetical scenario without Magpie. The shaded gap represents time back for maintainers.</desc>
      <rect class="chart-wash" x={adoption} y="0" width={900 - adoption} height="390" />
      <line class="phase-divider" x1={boom} x2={boom} y1="0" y2="390" />
      <line class="phase-divider" x1={adoption} x2={adoption} y1="0" y2="390" />
      <path class="saved-time-area" d={savedArea} />
      {curves.map(curve => <path id={curve.id} class={curve.line} d={curve.path} />)}
      <circle class="incoming-dot" cx="855" cy="32" r="4" />
      <circle class="without-dot" cx="855" cy="135" r="4" />
      <circle class="time-dot" cx="855" cy="350" r="4" />
      {curves.map(curve => <text class:list={["curve-label", "desktop-label", curve.tone]} dy={curve.below ? 24 : -12} text-anchor={curve.end ? "end" : "start"}>
        <textPath href={`#${curve.id}`} startOffset={curve.end ? "99%" : "1%"}>{curve.label}</textPath>
      </text>)}
      <text class="saved-time-label" x="785" y="225" text-anchor="middle"><tspan x="785">Time back</tspan><tspan x="785" dy="23">for maintainers</tspan></text>
    </svg>
    <div class="chart-axis" aria-label="Time in months">
      {ticks.map(tick => <span style={`left:${x(tick.month) / 9}%`}><time datetime={`${tick.month}-01`}>{tick.label}</time></span>)}
    </div>
  </div>
  <ul class="chart-legend" aria-label="Chart legend">
    <li class="chart-key incoming-key">Incoming external security reports</li>
    <li class="chart-key without-key">Maintainer time without Magpie</li>
    <li class="chart-key time-key">Maintainer time with Magpie</li>
  </ul>
  <p class="saved-time-caption">Shaded area: time back for maintainers</p>
  <figcaption class="chart-note"><span>Illustrative trends</span> <a class="text-link" href="/stories/airflow" target="_blank" rel="noreferrer"><span>Read the story and data</span><ArrowRight className="cta-arrow" aria-hidden="true" /></a></figcaption>
</figure>
<style>
.airflow-chart-story{--incoming:#b4483d;--time:var(--result-accent);--without:#936000;--chart-rule:color-mix(in srgb,var(--ink) 18%,transparent);display:grid;gap:var(--heading-gap);margin:0 auto;max-width:900px;color:var(--ink)}
:global(html[data-theme=dark]) .airflow-chart-story{--incoming:#f19b91;--without:#e5bd70}
.chart-frame{border-radius:var(--radius-card);background:var(--surface)}
.chart-phases{display:grid;align-items:stretch;min-height:78px;border-bottom:1px solid var(--chart-rule);color:var(--muted);font-size:var(--text-reading)}
.chart-phases>div{display:flex;flex-direction:column;justify-content:center;align-items:center;gap:var(--space-2);padding:var(--space-4) var(--space-3);border-right:1px solid var(--chart-rule)}
.chart-phases>div:last-child{border-right:0;border-start-end-radius:var(--radius-card);background:color-mix(in srgb,var(--time) 6%,transparent)}
.chart-boom .card-badge{color:var(--incoming)}
.chart-adoption{color:var(--time);font-weight:500}
.chart-frame>svg{display:block;width:100%;height:auto}
.chart-wash{fill:var(--time);opacity:.06}
.phase-divider{stroke:var(--muted);opacity:.18}
.incoming-line,.time-line,.without-line,.manual-history{fill:none;stroke-width:2.5;stroke-linecap:round;stroke-linejoin:round}
.incoming-line{stroke:var(--incoming);stroke-dasharray:9 7}
.time-line{stroke:var(--time)}
.manual-history,.without-line{stroke:var(--without)}
.without-line{stroke-dasharray:2 7}
.incoming-dot,.incoming-label{fill:var(--incoming)}
.without-dot,.without-label{fill:var(--without)}
.time-dot,.time-label{fill:var(--time)}
.saved-time-area{fill:var(--time);opacity:.16}
.curve-label{font-size:var(--text-reading);font-weight:500}
.saved-time-label{fill:var(--time);font-size:var(--text-reading);font-weight:600}
.saved-time-caption,.chart-legend{display:none}
.chart-key{display:flex;align-items:center;gap:10px}
.chart-key::before{content:'';width:24px;flex:none;border-top:2px solid currentColor}
.incoming-key{color:var(--incoming)}
.incoming-key::before{border-top-style:dashed}
.without-key{color:var(--without)}
.without-key::before{border-top-style:dotted}
.time-key{color:var(--time)}
.chart-axis{position:relative;height:48px;margin-inline:0;border-top:1px solid var(--chart-rule);font-size:var(--text-reading);color:var(--muted)}
.chart-axis>span{position:absolute;top:0;padding-top:14px;transform:translateX(-50%);white-space:nowrap}
.chart-axis>span:before{content:'';position:absolute;left:50%;top:0;height:6px;border-left:1px solid var(--chart-rule)}
.chart-axis>span:first-child{transform:none}
.chart-axis>span:first-child:before{left:0}
.chart-axis>span:last-child{transform:translateX(-100%)}
.chart-axis>span:last-child:before{left:100%}
.chart-note{display:flex;justify-content:space-between;align-items:center;gap:var(--space-4);flex-wrap:wrap;font-size:var(--text-reading);color:var(--muted);margin:0}
.chart-note a{margin-left:auto}
@media(max-width:700px){
 .chart-phases{min-height:86px}
 .chart-phases>div{padding-inline:6px}
 .chart-frame>svg{min-height:180px}
 .saved-time-label,.desktop-label{display:none}
 .chart-legend{display:grid;gap:8px;width:fit-content;max-width:100%;list-style:none;padding:0;margin:0 auto;font-size:var(--text-reading);line-height:1.4}
 .saved-time-caption{display:block;text-align:center;color:var(--time);font-size:var(--text-reading);font-weight:600;margin:0}
 .chart-axis>span:not(:first-child):not(:last-child){display:none}
}
</style>
