---
import "../styles/global.css";
import "../styles/spacing.css";
import "../styles/redesign.css";
import "../styles/reading-flow.css";
import "../styles/feedback.css";

interface Props {
  title?: string;
  description?: string;
  /** Site-root-relative path to the social-share (Open Graph) image.
   *  Defaults to the branded 1200×630 card. */
  image?: string;
  /** GitHub edit link for this page's source, shown as "Suggest a change".
   *  The review overlay, where it runs, hides this button and offers the
   *  same link from its own menu. */
  editUrl?: string;
}

const {
  title = "Apache Magpie | Give maintainers time back",
  description = "AI agent skills for open-source maintainers. Prepare reviews, triage reports, and keep decisions in your hands.",
  image = "/og-image.png",
  editUrl,
} = Astro.props;

// Absolute URLs for social-share (Open Graph / Twitter) tags. Scrapers require
// absolute image URLs, so resolve against the configured `site`. The default is
// the 1200×630 branded social card (public/og-image.png); individual pages may
// pass their own `image` (a site-root-relative path) to override it.
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(
  `${import.meta.env.BASE_URL.replace(/\/$/, "")}${image}`,
  Astro.site,
).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      try { document.documentElement.dataset.theme = localStorage.getItem('magpie-theme') || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light'); } catch { document.documentElement.dataset.theme = 'light'; }
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.svg`} />
    {/* ICO fallback for clients that don't use the SVG icon (Safari, some
        link/tab unfurlers), which otherwise request /favicon.ico implicitly. */}
    <link rel="icon" type="image/x-icon" sizes="any" href={`${import.meta.env.BASE_URL.replace(/\/$/, "")}/favicon.ico`} />
    {/* Geist is self-hosted; no external font CDN is loaded. */}
    <title>{title}</title>
    {/* Social-share preview (Open Graph + Twitter Card): show the branded Magpie
        card, not the framework default, when links are unfurled on social media. */}
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Apache Magpie" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {/* ASF Matomo analytics (site id 89), as issued by the ASF Privacy team
        (privacy@apache.org). Cookieless and Do-Not-Track-respecting per ASF
        policy; the tracker is self-hosted at analytics.apache.org. The Privacy
        team recommends placing this immediately before </head>. is:inline keeps
        it verbatim so Astro does not bundle/transform it. */}
    <script is:inline>
      if (location.hostname === "magpie.apache.org") {
      var _paq = (window._paq = window._paq || []);
      /* tracker methods like "setCustomDimension" should be called before "trackPageView" */
      _paq.push(["setDoNotTrack", true]);
      _paq.push(["disableCookies"]);
      _paq.push(["trackPageView"]);
      _paq.push(["enableLinkTracking"]);
      (function () {
        var u = "https://analytics.apache.org/";
        _paq.push(["setTrackerUrl", u + "matomo.php"]);
        _paq.push(["setSiteId", "89"]);
        var d = document,
          g = d.createElement("script"),
          s = d.getElementsByTagName("script")[0];
        g.async = true;
        g.src = u + "matomo.js";
        s.parentNode.insertBefore(g, s);
      })();
      }
    </script>
  </head>
  <body>
    <slot />
    {editUrl && (
      <a href={editUrl} target="_blank" rel="noopener noreferrer" class="suggest-change" aria-label="Suggest a change to this page on GitHub">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20h9" />
          <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z" />
        </svg>
        <span class="suggest-change-label">Suggest a change</span>
      </a>
    )}
    <script>
      import { trackScrollLocation } from '../lib/scroll-location';
      trackScrollLocation();
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
      const sync = () => { const dark = document.documentElement.dataset.theme === 'dark'; button?.setAttribute('aria-pressed', String(dark)); button?.setAttribute('aria-label', `Switch to ${dark ? 'light' : 'dark'} mode`); };
      button?.addEventListener('click', () => { document.documentElement.dataset.theme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; try { localStorage.setItem('magpie-theme', document.documentElement.dataset.theme); } catch {} sync(); });
      sync();

    </script>


  </body>
</html>

<style>
  .suggest-change {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 50;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    border-radius: var(--radius-round);
    background: var(--action-bg);
    color: var(--action-ink);
    font-size: var(--text-small);
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    box-shadow: var(--surface-shadow);
  }
  .suggest-change:hover { background: var(--action-hover); }
  @media (max-width: 640px) {
    .suggest-change { right: 1rem; bottom: 1rem; padding: 0.625rem; }
    .suggest-change-label { display: none; }
  }
</style>
